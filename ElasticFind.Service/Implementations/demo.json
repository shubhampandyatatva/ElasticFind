{
    "bool": {
        "must": [
            {
                "match": {
                    "attachment.content": "java"
                }
            },
            {
                "match": {
                    "attachment.content": "python"
                }
            },
            {
                "wildcard": {
                    "fileName.keyword": "*res*"
                }
            },
            {
                "match": {
                    "fileType": "pdf"
                }
            }
        ]
    }
}