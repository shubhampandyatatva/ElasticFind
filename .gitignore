## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results (applies to all projects)
**/[Bb]in/
**/[Oo]bj/
**/[Ll]og/
**/[Ll]ogs/

# Visual Studio cache/options
.vs/
.vscode/

# NuGet packages
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nupkg
*.snupkg
*.nuget.props
*.nuget.targets

# Microsoft Azure Web App publish settings
*.PublishSettings

# Publish Web Output
**/[Pp]ublishProfiles/
*.pubxml
*.pubxml.user
**/Properties/PublishProfiles/

# Temporary files
*.tmp
*.temp
*.log
*.bak
*.backup
*.swp
*.swo

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Rider
.idea/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# T4 templates
*.tt
*.ttinclude

# Entity Framework
*.mdf
*.ldf

# Compiled files
*.dll
*.pdb
*.cache
