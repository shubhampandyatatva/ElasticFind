<script>
    let latestSearchResults = [];
    var startDate = "";
    var endDate = "";

    $(document).ready(function () {
        const today = new Date().toISOString().split('T')[0];
        $("#endDate").attr("max", today);
        $("#startDate").attr("max", today);
        @* $("#endDate").val(today); *@
    });

    function searchDocumentContent() {
        var keyword = $("#searchKeywordInput").val().trim();
        if (!keyword) {
            alert("Please enter a keyword to search.");
            return;
        }
        var searchType = $("#searchTypeSelect").val().trim();
        var matchAllTerms = $("#matchAllCheckbox").is(":checked") ? true : false;
        var fileTypeFitler = $("#fileTypeFilter").val().trim();
        var sortBy = $("#sortBySelect").val().trim();
        var searchInput = $("#searchInput").val().trim();
        console.log("Searching with parameters:", { searchType: searchType, matchAllTerms: matchAllTerms, keyword: keyword, fileTypeFilter: fileTypeFitler, startDate: startDate, endDate: endDate, sortBy: sortBy, searchInput: searchInput });

        $("#loader").find(".spinner-border").removeClass("text-success").addClass("text-primary");
        @* $("#loader").show(); *@
            $("#loader").css("display", "flex");

        $.ajax({
            url: "/Home/SearchDocumentContent",
            type: "POST",
            data: { searchType: searchType, matchAllTerms: matchAllTerms, keyword: keyword, fileTypeFilter: fileTypeFitler, startDate: startDate, endDate: endDate, sortBy: sortBy, searchInput: searchInput },
            success: function (data) {
                var html = "";
                console.log("Search results:", data);
                console.log("Data length:", data.length);

                if (data.length === 0) {
                    html = "<div class='alert alert-warning'>No results found.</div>";
                } else {
                    data.forEach(function (doc, index) {
                        let totalHighlights = 0;
                        doc.snippets.forEach(snippet => {
                            totalHighlights += (snippet.match(/<mark>/g) || []).length;
                        });

                        html += `
                            <div class="card mb-4">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>${doc.fileName}</strong>
                                        <span class="text-muted"> - Found ${totalHighlights} match${totalHighlights === 1 ? '' : 'es'}</span>
                                    </div>
                                    <div class="pdf-exclude">
                                        <span class="d-flex align-items-center">
                                        <button class="btn btn-sm btn-outline-primary single-export-btn me-2"" data-id="${doc.id}" title="Export this search result">
                                            <i class="bi bi-file-earmark-arrow-up"></i>
                                        </button>
                                        <button onclick="downloadFile('${doc.id}', '${doc.fileName}')" class="btn btn-sm btn-outline-secondary me-2" title="Download">
                                            <i class="bi bi-download"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-primary preview-btn" data-id="${doc.id}" title="Preview">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        </span>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <ul class="list-group">
                        `;

                        doc.snippets.forEach(function (snippet, idx) {
                            const isHidden = idx >= 5 ? 'd-none extra-snippet' : '';
                            html += `<li class="list-group-item ${isHidden}" data-doc-index="${index}">${snippet}</li>`;
                        });

                        if (doc.snippets.length > 5) {
                            html += `
                                    <li class="list-group-item">
                                        <a href="#" class="toggle-snippets-link" data-doc-index="${index}" data-expanded="false">View all matches</a>
                                    </li>
                                `;
                        }

                        html += `
                                    </ul>
                                </div>
                            </div>
                        `;
                    });
                }

                $("#searchResults").html(html);

                $("#searchResults").scrollTop(0); 
                @* document.getElementById("searchResults").scrollTo({
                    top: 0,
                    behavior: "smooth"
                }); *@

                latestSearchResults = data;

                if (data.length > 0) {
                    $("#exportSection").removeClass("d-none");
                } else {
                    $("#exportSection").addClass("d-none");
                }

                $("#filtersSortersContainer").removeClass("d-none");
                $(".matching-docs-count").removeClass("d-none");
                $("#matchingDocsCountSpan").text(`${data.length} matching document${data.length === 1 ? '' : 's'}`);
                $(".results-text").addClass("d-none");
            },
            error: function (xhr) {
                $("#searchResults").html("<div class='alert alert-danger'>An error occurred while searching.</div>");
            },
            complete: function () {
                @* $("#loader").css("display", "none"); *@
                    $("#loader").hide();
            }
        });
    }

    $(document).ready(function () {
        $('#uploadForm').submit(function (e) {
            e.preventDefault();

            var formData = new FormData();
            var fileInput = $('#file')[0];

            if (fileInput.files.length === 0) {
                alert("Please select a file.");
                return;
            }

            formData.append("file", fileInput.files[0]);

            $.ajax({
                url: '@Url.Action("UploadDocument", "Home")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    alert("File uploaded successfully!");
                    console.log(response);
                },
                error: function (xhr, status, error) {
                    alert("Upload failed.");
                    console.error(xhr.responseText);
                }
            });
        });
    });

    $(document).on("keypress", "#searchKeywordInput", function (e) {
        if (e.key === "Enter") {
            startDate = $("#startDate").val();
            endDate = $("#endDate").val();
            searchDocumentContent();
        }
    });

    $("#searchKeywordBtn").on("click", function () {
        startDate = $("#startDate").val();
        endDate = $("#endDate").val();
        searchDocumentContent();
        clearFilters();
    });

    $(document).on("change", "#fileTypeFilter", function () {
        startDate = $("#startDate").val();
        endDate = $("#endDate").val();
        searchDocumentContent();
    });

    $(document).on("change", "#sortBySelect", function () {
        startDate = $("#startDate").val();
        endDate = $("#endDate").val();
        searchDocumentContent();
    });

    // Debounce function to wait for user search
    function debounce(func, delay) {
        let timeoutId;
        return function (...args) {
            clearTimeout(timeoutId);
            timeoutId = setTimeout(() => func.apply(this, args), delay);
        };
    }
    const debounceSearch = debounce(function () {
        startDate = $("#startDate").val();
        endDate = $("#endDate").val();
        searchDocumentContent();
    }, 500);

    $(document).on("input", "#searchInput", debounceSearch);

    $("#applyCustomDateBtn").on("click", function () {
        startDate = $("#startDate").val();
        endDate = $("#endDate").val();

        if (!startDate && !endDate) {
            @* $("#startDateError").text("Please select a start date.").addClass("text-danger"); *@
                @* $("#endDateError").text("Please select an end date.").addClass("text-danger"); *@
                $("#endDateError").text("Please select either a start date or an end date.").addClass("text-danger");
            return;
        }
        @* if (!startDate) {
            $("#startDateError").text("Please select a start date.").addClass("text-danger");
            return;
        } else {
            $("#startDateError").text("").removeClass("text-danger");
        }
        if (!endDate) {
            $("#endDateError").text("Please select an end date.").addClass("text-danger");
            return;
        } else {
            $("#endDateError").text("").removeClass("text-danger");
        } *@
            @* validateDateInputs(); *@

        if (!startDate) {
            startDate = new Date(Date.UTC(2000, 0, 1)).toISOString().split('T')[0];
        }
        if (!endDate) {
            endDate = new Date().toISOString().split('T')[0].toString("dd-MM-yyyy");
            console.log("End date is not selected, setting to today:", endDate);
        }

        searchDocumentContent();
        $("#startDate").val(startDate);
        $("#endDate").val(endDate);
        $("#datePickerModal").modal("hide");
        $("#selectDateButton").text(startDate && endDate ? `${new Date(startDate).toLocaleDateString('en-GB')} - ${new Date(endDate).toLocaleDateString('en-GB')}` : "Select Uploaded Date");
    });

    @* $("#startDate, #endDate").on("change", validateDateInputs); *@
        $(document).on("change", "#startDate, #endDate", function () {
            @* const StartDate = $("#startDate").val();
        const EndDate = $("#endDate").val(); *@
                startDate = $("#startDate").val();
            endDate = $("#endDate").val();
            console.log("Start Date: ", startDate);
            console.log("End Date: ", endDate);
            @* console.log("Today's date: ", new Date().toISOString().split('T')[0].toString("dd-MM-yyyy")); *@

        if (!startDate && !endDate) {
                $("#endDateError").text("Please select either a start date or an end date.").addClass("text-danger");
                return;
            } else {
                $("#endDateError").text("").removeClass("text-danger");
                return;
            }

            if (!startDate) {
                startDate = "01-01-2000";
                $("#startDate").val(startDate);
                console.log("start date: ", startDate);
            }

            if (!endDate || endDate == undefined || endDate == null || endDate == "") {
                @* endDate = new Date().toISOString().split('T')[0]; *@
                    @* endDate = new Date().toISOString().split('T')[0].toString("dd-MM-yyyy"); *@
                    endDate = new Date().toLocaleDateString('en-GB');
                $("#endDate").val(endDate);
                console.log("end date: ", endDate);
            }
        });

    function validateDateInputs() {
        const startDate = $("#startDate").val();
        const endDate = $("#endDate").val();

        @* if (startDate) {
            $("#startDateError").text("").removeClass("text-danger");
        } else {
            $("#startDateError").text("Please select a start date.").addClass("text-danger");
        }

        if (endDate) {
            $("#endDateError").text("").removeClass("text-danger");
        } else {
            $("#endDateError").text("Please select an end date.").addClass("text-danger");
        } *@

        if (startDate) {
            $("#startDateError").text("").removeClass("text-danger");
        }

        if (endDate) {
            $("#endDateError").text("").removeClass("text-danger");
        }
    }

    $("#datePickerCloseBtn").on("click", function () {
        $("#startDateError").text("");
        $("#endDateError").text("");
    });

    // Restrict endDate based on startDate and vice versa
    $("#startDate").on("change", function () {
        const startDate = $(this).val();
        if (startDate) {
            $("#endDate").attr("min", startDate);
        } else {
            $("#endDate").removeAttr("min");
        }
    });
    $("#endDate").on("change", function () {
        const endDate = $(this).val();
        if (endDate) {
            $("#startDate").attr("max", endDate);
        } else {
            $("#startDate").removeAttr("max");
        }
    });

    $("#datePickerClearBtn").on("click", function () {
        $("#startDate").val("");
        $("#endDate").val("");
        startDate = "";
        endDate = "";
        $("#startDateError").text("");
        $("#endDateError").text("");
        $("#startDate").removeAttr("min");
        $("#endDate").removeAttr("min");
        $("#startDate").attr("max", new Date().toISOString().split('T')[0]);
        $("#endDate").attr("max", new Date().toISOString().split('T')[0]);
        $("#datePickerModal").modal("hide");
        $("#selectDateButton").text("Select Uploaded Date");
        searchDocumentContent();
    });

    // Toggle snippets visibility
    $(document).on("click", ".toggle-snippets-link", function (e) {
        e.preventDefault();
        const link = $(this);
        const index = link.data("doc-index");
        const expanded = link.data("expanded");

        if (!expanded) {
            $(`li.extra-snippet[data-doc-index='${index}']`).removeClass("d-none");
            link.text("Show less");
            link.data("expanded", true);
        } else {
            $(`li.extra-snippet[data-doc-index='${index}']`).addClass("d-none");
            link.text("View all matches");
            link.data("expanded", false);
        }
    });

    //Preview Button
    $(document).on("click", ".preview-btn", function () {
        const fileId = $(this).data("id");
        console.log("Previewing file with ID:", fileId);

        @* $("#onlyofficeFrame").attr("src", `/Home/OnlyOfficeViewerPage?id=${fileId}`); *@
            window.location.href = `/Home/OnlyOfficeViewerPage?id=${fileId}`;
        @* $("#previewModal").modal("show"); *@
    });

    function clearFilters() {
        $("#fileTypeFilter").val("File Type");
        $("#startDate").val("");
        $("#endDate").val("");
        $("#sortBySelect").val("1");
        $("#searchInput").val("");
        startDate = "";
        endDate = "";
        $("#selectDateButton").text("Select Uploaded Date");
    }

    // Clear Button
    $("#clearButton").on("click", function () {
        $("#searchKeywordInput").val("");
        $("#searchResults").empty();
        $("#exportSection").addClass("d-none");
        $("#filtersSortersContainer").addClass("d-none");
        $(".matching-docs-count").addClass("d-none");
        $(".results-text").removeClass("d-none");
        clearFilters();
    });

    function exportToCSV(data) {
        let csvContent = "data:text/csv;charset=utf-8,";
        csvContent += "File Name,Match Count,Snippets\n";

        data.forEach(doc => {
            const totalMatches = doc.snippets.reduce((acc, snip) => acc + (snip.match(/<mark>/g) || []).length, 0);
            const flatSnippets = doc.snippets.map(s => s.replace(/(<([^>]+)>)/gi, "")).join(" | "); // remove HTML
            csvContent += `"${doc.fileName}",${totalMatches},"${flatSnippets}"\n`;
        });

        const encodedUri = encodeURI(csvContent);
        const link = document.createElement("a");
        link.setAttribute("href", encodedUri);
        link.setAttribute("download", "search_results.csv");
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }

    $("#exportToExcelBtn").on("click", function (e) {
        e.preventDefault();
        $("#loader").find(".spinner-border").removeClass("text-primary").addClass("text-success");
        $("#loader").show();

        const keyword = $("#searchKeywordInput").val();
        const fileType = $("#fileTypeFilter").val();
        const sortBy = $("#sortBySelect").val();
        const searchInput = $("#searchInput").val() || null;
        const searchType = $("#searchTypeSelect").val();
        const matchAllTerms = $("#matchAllCheckbox").is(":checked");

        const url = `/Home/ExportResultsToExcel?keyword=${keyword}&fileType=${fileType}&startDate=${startDate}&endDate=${endDate}&sortBy=${sortBy}&searchInput=${searchInput}&searchType=${searchType}&matchAllTerms=${matchAllTerms}`;

        $.ajax({
            url: url,
            method: 'GET',
            xhrFields: {
                responseType: 'blob'
            },
            success: function (blob) {
                const a = document.createElement('a');
                a.href = window.URL.createObjectURL(blob);
                a.download = "ElasticFind_Results.xlsx";
                a.click();
            },
            error: function () {
                alert("Failed to export Excel");
            },
            complete: function () {
                $("#loader").hide();
            }
        });
    });


    $("#exportToPdfBtn").on("click", function () {
        $("#loader").find(".spinner-border").removeClass("text-primary").addClass("text-success");
        $("#loader").show();

        // Extract data from current results
        var searchType = $("#searchTypeSelect").val();
        if (searchType == "1") {
            searchType = "Full-Text Search";
        } else if (searchType == "2") {
            searchType = "Multiple-Text Search";
        } else if (searchType == "3") {
            searchType = "Fuzzy Search";
        } else if (searchType == "4") {
            searchType = "Synonym Search";
        }
        const keyword = $("#searchKeywordInput").val();
        const fileType = $("#fileTypeFilter").val().replace(".", "");
        var sortBy = $("#sortBySelect").val();
        if (sortBy == "1") {
            sortBy = "Date";
        } else if (sortBy == "2") {
            sortBy = "File Type";
        } else {
            sortBy = "No sorting";
        }
        const searchString = $("#searchInput").val() || null;
        if (!startDate || !endDate) {
            startDate = null;
            endDate = null;
        }
        const results = [];

        $("#searchResults .card").each(function () {
            const fileName = $(this).find(".card-header strong").text().trim();
            const matchText = $(this).find(".card-header .text-muted").text();
            const matchCount = parseInt(matchText.match(/\d+/)[0]);

            const snippets = [];
            $(this).find(".list-group-item").each(function () {
                // Skip the item if it contains the "View all matches" link
                const anchor = $(this).find("a.toggle-snippets-link");
                if (anchor.length === 0) {
                    snippets.push($(this).html().trim());
                }
            });

            results.push({
                fileName,
                matchCount,
                snippets
            });
        });
        console.log("Exporting filters:", {
            searchType, keyword, fileType, startDate, endDate, sortBy, searchString, results
        });
        // Send to backend
        $.ajax({
            url: '/Home/ExportToPdf',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                searchType, keyword, fileType, startDate, endDate, sortBy, searchString, results
            }),
            xhrFields: {
                responseType: 'blob'  // so we can download the PDF
            },
            success: function (blob) {
                const link = document.createElement('a');
                link.href = window.URL.createObjectURL(blob);
                link.download = "ElasticFind_Results.pdf";
                link.click();
            },
            error: function () {
                alert("Failed to export PDF");
            },
            complete: function () {
                $("#loader").hide();
            }
        });
    });

