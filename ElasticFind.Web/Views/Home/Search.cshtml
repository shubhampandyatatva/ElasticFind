<!-- Preview Modal -->
<div class="modal fade" id="previewModal" tabindex="-1" aria-labelledby="previewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="previewModalLabel">Preview File</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0" style="height: 80vh;">
                <iframe id="onlyofficeFrame" style="width: 100%; height: 100%; border: none;"></iframe>
            </div>
        </div>
    </div>
</div>

<!-- Date Picker Modal -->

<div class="modal fade" id="datePickerModal" tabindex="-1" aria-labelledby="datePickerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="datePickerModalLabel">Select Date Range</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="startDate" class="form-label">Start Date</label>
                    <input type="date" class="form-control pointer" id="startDate" onclick="this.showPicker();">
                    <div id="startDateError" class="ms-2"></div>
                </div>
                <div class="mb-3">
                    <label for="endDate" class="form-label">End Date</label>
                    <input type="date" class="form-control pointer" id="endDate" onclick="this.showPicker();">
                    @* <div id="endDateError" class="ms-2"></div> *@
                </div>
                <div id="endDateError" class="ms-2"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="applyCustomDateBtn">Apply</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"
                    id="datePickerCloseBtn">Close</button>
                <button type="button" class="btn btn-secondary" id="datePickerClearBtn">Clear Filter</button>
            </div>
        </div>
    </div>
</div>

<!-- Search loader -->

<div id="loader"
    class="position-fixed top-0 start-0 w-100 h-100 justify-content-center align-items-center bg-white bg-opacity-75"
    style="display: none; z-index: 9999;">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Searching...</span>
    </div>
</div>

<!-- Export loader -->

