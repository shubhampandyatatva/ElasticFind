    $("#searchTypeSelect").on("change", function () {
        const searchType = $(this).val();
        if (searchType == "1") {
            $(".match-all-checkbox-container").addClass("d-none");
            $(".info-text").addClass("d-none");
        } else if (searchType == "2") {
            $(".match-all-checkbox-container").removeClass("d-none");
            $("#matchAllCheckbox").prop("checked", false);
            $(".info-text").text("Note: Enter multiple keywords separated by spaces. Check \"Match All Terms\" checkbox to display only those documents which contain all the keywords.").removeClass("d-none");
        } else if (searchType == "3") {
            $(".match-all-checkbox-container").removeClass("d-none");
            $(".info-text").text("Note: Enter more than two characters for best results").removeClass("d-none");
        } else {
            $(".match-all-checkbox-container").addClass("d-none");
            $(".info-text").addClass("d-none");
        }
    });

    function downloadFile(fileId, fileName) {
        $("#loader").find(".spinner-border").removeClass("text-success").addClass("text-primary");
        $("#loader").show();

        $.ajax({
            url: `/Home/Download/${fileId}`,
            method: "GET",
            xhrFields: {
                responseType: 'blob' // Get the raw binary data
            },
            success: function (data, status, xhr) {
                const blob = new Blob([data], { type: xhr.getResponseHeader('Content-Type') });
                const downloadUrl = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = downloadUrl;
                a.download = fileName;
                document.body.appendChild(a);
                a.click();
                a.remove();
                URL.revokeObjectURL(downloadUrl);
                console.log("successss!");
            },
            error: function () {
                alert("Error downloading file.");
            },
            complete: function () {
                $("#loader").hide();
            }
        });
    }
</script>