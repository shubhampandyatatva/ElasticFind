<h3 class="mb-4" style="color: #305796;">Search Documents</h3>

<div class="d-flex flex-column flex-md-row align-items-start gap-3 mb-4">
    <input type="text" class="form-control flex-grow-1" id="searchKeywordInput" placeholder="Enter keyword...">
    <div class="buttons d-flex align-items-center">
        <button type="button" class="btn btn-primary me-2" id="searchKeywordBtn">Search</button>
        <button type="button" class="btn btn-outline-primary" id="clearButton">Clear</button>
    </div>
</div>

<div class="d-flex align-items-center mb-4">
<h3 class="results-text me-3" style="color: #3f629b;">Your Results Go Here</h3>
<h4 class="matching-docs-count d-none" style="color: #3f629b;">Found <span id="matchingDocsCount"></span> matching documents</h4>
</div>

<div class="filters-sorters-container d-flex justify-content-between align-items-center d-none"
    id="filtersSortersContainer">
    <div class="filters-sorters d-flex align-items-center">
        <div class="filter-container d-flex align-items-center me-3 flex-wrap">
            <div class="fs-5 me-2" style="font-weight: 500;">Filters: </div>
            <div class="filters d-flex align-items-center">
                <select class="select-filter form-select form-select-sm pointer" aria-label="Small select example"
                    style="width: 125px;" id="fileTypeFilter">
                    <option selected>File Type</option>
                    <option value=".pdf">pdf</option>
                    <option value=".xlsx">xlsx</option>
                    <option value=".docx">docx</option>
                    <option value=".xls">xls</option>
                    <option value=".doc">doc</option>
                    <option value=".txt">txt</option>
                    <option value=".pptx">pptx</option>
                    <option value=".ppt">ppt</option>
                    <option value=".rtf">rtf</option>
                </select>
                <button type="button" class="btn btn-sm ms-2" id="selectDateButton" data-bs-toggle="modal"
                    data-bs-target="#datePickerModal"
                    style="width: 100px; border: 1px solid rgb(206, 206, 206); background-color: #fff;">Select
                    Date</button>
            </div>
        </div>

        <div class="sorter-container d-flex align-items-center">
            <div class="fs-5" style="font-weight: 500;">Sort By: </div>
            <select class="select-sorter form-select form-select-sm ms-2 pointer" aria-label="Small select example"
                style="width: 125px;" id="sortBySelect">
                <option selected>Sort By</option>
                <option value="1">Date</option>
                <option value="2">File Type</option>
            </select>
        </div>
    </div>

    <div class="search d-flex align-items-center">
        <input type="text" id="searchInput" placeholder="Search by file name..." class="form-control form-control-sm"
            style="width: 190px;">
        <img src="~/images/search-icon.svg" alt="Search Icon" class="search-icon">
    </div>
</div>

<div id="searchResults" class="mt-4" style="max-height: 50vh; overflow-y: auto;">

</div>

<div id="exportSection" class="mt-3 d-none">
    <div class="dropdown">
        <button class="btn btn-primary dropdown-toggle" type="button" id="exportDropdown" data-bs-toggle="dropdown"
            aria-expanded="false">
            Export Results
        </button>
        <ul class="dropdown-menu" aria-labelledby="exportDropdown">
            <li><a class="dropdown-item" id="exportPdfBtn">Export as PDF</a></li>
            <li><a class="dropdown-item" id="exportCsvBtn">Export as CSV</a></li>
        </ul>
    </div>
</div>

<!-- Preview Modal -->
<div class="modal fade" id="previewModal" tabindex="-1" aria-labelledby="previewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="previewModalLabel">Preview File</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0" style="height: 80vh;">
                <iframe id="onlyofficeFrame" style="width: 100%; height: 100%; border: none;"></iframe>
            </div>
        </div>
    </div>
</div>

<!-- Date Picker Modal -->

<div class="modal fade" id="datePickerModal" tabindex="-1" aria-labelledby="datePickerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="datePickerModalLabel">Select Date Range</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="startDate" class="form-label">Start Date</label>
                    <input type="date" class="form-control pointer" id="startDate" onclick="this.showPicker();">
                    <div id="startDateError" class="ms-2"></div>
                </div>
                <div class="mb-3">
                    <label for="endDate" class="form-label">End Date</label>
                    <input type="date" class="form-control pointer" id="endDate" onclick="this.showPicker();">
                    <div id="endDateError" class="ms-2"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="applyCustomDateBtn">Apply</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="datePickerCloseBtn">Close</button>
                <button type="button" class="btn btn-secondary" id="datePickerClearBtn">Clear</button>
            </div>
        </div>
    </div>
</div>

<script>
    let latestSearchResults = [];
    var startDate = "";
    var endDate = "";

    function searchDocumentContent() {
        var keyword = $("#searchKeywordInput").val();
        if (!keyword) {
            alert("Please enter a keyword to search.");
            return;
        }
        var fileTypeFitler = $("#fileTypeFilter").val();
        var sortBy = $("#sortBySelect").val();
        var searchInput = $("#searchInput").val();
        console.log("Searching with parameters:", { keyword: keyword, fileTypeFilter: fileTypeFitler, startDate: startDate, endDate: endDate, sortBy: sortBy, searchInput: searchInput });

        $.ajax({
            url: "/Home/SearchDocumentContent",
            type: "POST",
            data: { keyword: keyword, fileTypeFilter: fileTypeFitler, startDate: startDate, endDate: endDate, sortBy: sortBy, searchInput: searchInput },
            success: function (data) {
                var html = "";
                console.log("Search results:", data);
                console.log("Data length:", data.length);

                if (data.length === 0) {
                    html = "<div class='alert alert-warning'>No results found.</div>";
                } else {
                    data.forEach(function (doc, index) {
                        let totalHighlights = 0;
                        doc.snippets.forEach(snippet => {
                            totalHighlights += (snippet.match(/<mark>/g) || []).length;
                        });

                        html += `
                            <div class="card mb-4">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>${doc.fileName}</strong>
                                        <span class="text-muted"> - Found ${totalHighlights} match${totalHighlights === 1 ? '' : 'es'}</span>
                                    </div>
                                    <div class="pdf-exclude">
                                        <span class="d-flex align-items-center">
                                        <a href="/Download/${doc.id}" class="btn btn-sm btn-outline-secondary me-2" title="Download">
                                            <i class="bi bi-download"></i>
                                        </a>
                                        <button class="btn btn-sm btn-outline-primary preview-btn" data-id="${doc.id}" title="Preview">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        </span>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <ul class="list-group">
                        `;

                        doc.snippets.forEach(function (snippet, idx) {
                            const isHidden = idx >= 5 ? 'd-none extra-snippet' : '';
                            html += `<li class="list-group-item ${isHidden}" data-doc-index="${index}">${snippet}</li>`;
                        });

                        if (doc.snippets.length > 5) {
                            html += `
                                    <li class="list-group-item">
                                        <a href="#" class="toggle-snippets-link" data-doc-index="${index}" data-expanded="false">View all matches</a>
                                    </li>
                                `;
                        }

                        html += `
                                    </ul>
                                </div>
                            </div>
                        `;
                    });
                }

                $("#searchResults").html(html);

                latestSearchResults = data;

                if (data.length > 0) {
                    $("#exportSection").removeClass("d-none");
                } else {
                    $("#exportSection").addClass("d-none");
                }

                $("#filtersSortersContainer").removeClass("d-none");
                $(".matching-docs-count").removeClass("d-none");
                $("#matchingDocsCount").text(data.length);
                $(".results-text").addClass("d-none");
            },
            error: function (xhr) {
                $("#searchResults").html("<div class='alert alert-danger'>An error occurred while searching.</div>");
            }
        });
    }

    $(document).ready(function () {
        $('#uploadForm').submit(function (e) {
            e.preventDefault();

            var formData = new FormData();
            var fileInput = $('#file')[0];

            if (fileInput.files.length === 0) {
                alert("Please select a file.");
                return;
            }

            formData.append("file", fileInput.files[0]);

            $.ajax({
                url: '@Url.Action("UploadDocument", "Home")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    alert("File uploaded successfully!");
                    console.log(response);
                },
                error: function (xhr, status, error) {
                    alert("Upload failed.");
                    console.error(xhr.responseText);
                }
            });
        });
    });

    $("#searchKeywordBtn").on("click", function () {
        startDate = $("#startDate").val();
        endDate = $("#endDate").val();
        searchDocumentContent();
    });

    $(document).on("change", "#fileTypeFilter", function () {
        startDate = $("#startDate").val();
        endDate = $("#endDate").val();
        searchDocumentContent();
    });

    $(document).on("change", "#sortBySelect", function () {
        startDate = $("#startDate").val();
        endDate = $("#endDate").val();
        searchDocumentContent();
    });

    $(document).on("input", "#searchInput", function () {
        startDate = $("#startDate").val();
        endDate = $("#endDate").val();
        searchDocumentContent();
    });

    $("#applyCustomDateBtn").on("click", function () {
        startDate = $("#startDate").val();
        endDate = $("#endDate").val();

        if (!startDate && !endDate) {
            $("#startDateError").text("Please select a start date.").addClass("text-danger");
            $("#endDateError").text("Please select an end date.").addClass("text-danger");
            return;
        }
        @* if (!startDate) {
            $("#startDateError").text("Please select a start date.").addClass("text-danger");
            return;
        } else {
            $("#startDateError").text("").removeClass("text-danger");
        }
        if (!endDate) {
            $("#endDateError").text("Please select an end date.").addClass("text-danger");
            return;
        } else {
            $("#endDateError").text("").removeClass("text-danger");
        } *@
        validateDateInputs();

        searchDocumentContent();
        $("#datePickerModal").modal("hide");
        $("#startDate").text("");
        $("#endDate").text("");
    });

    function validateDateInputs() {
        const startDate = $("#startDate").val();
        if (startDate) {
            $("#startDateError").text("").removeClass("text-danger");
        } else {
            $("#startDateError").text("Please select a start date.").addClass("text-danger");
        }

        const endDate = $("#endDate").val();
        if (endDate) {
            $("#endDateError").text("").removeClass("text-danger");
        } else {
            $("#endDateError").text("Please select an end date.").addClass("text-danger");
        }
    }

    $("#startDate, #endDate").on("change", validateDateInputs);

    $("#datePickerCloseBtn").on("click", function () {
        $("#startDateError").text("");
        $("#endDateError").text("");
    });

    // Restrict endDate based on startDate and vice versa
    $("#startDate").on("change", function () {
        const startDate = $(this).val();
        if (startDate) {
            $("#endDate").attr("min", startDate);
        } else {
            $("#endDate").removeAttr("min");
        }
    });
    $("#endDate").on("change", function () {
        const endDate = $(this).val();
        if (endDate) {
            $("#startDate").attr("max", endDate);
        } else {
            $("#startDate").removeAttr("max");
        }
    });

    $("#datePickerClearBtn").on("click", function () {
        $("#startDate").val("");
        $("#endDate").val("");
        @* validateDateInputs(); *@
    });

    // Toggle snippets visibility
    $(document).on("click", ".toggle-snippets-link", function (e) {
        e.preventDefault();
        const link = $(this);
        const index = link.data("doc-index");
        const expanded = link.data("expanded");

        if (!expanded) {
            $(`li.extra-snippet[data-doc-index='${index}']`).removeClass("d-none");
            link.text("Show less");
            link.data("expanded", true);
        } else {
            $(`li.extra-snippet[data-doc-index='${index}']`).addClass("d-none");
            link.text("View all matches");
            link.data("expanded", false);
        }
    });

    //Preview Button
    $(document).on("click", ".preview-btn", function () {
        const fileId = $(this).data("id");
        console.log("Previewing file with ID:", fileId);

        $("#onlyofficeFrame").attr("src", `/Home/OnlyOfficeViewerPage?id=${fileId}`);
        $("#previewModal").modal("show");
    });

    function clearFilters() {
        $("#fileTypeFilter").val("File Type");
        $("#startDate").val("");
        $("#endDate").val("");
        $("#sortBySelect").val("Sort By");
        $("#searchInput").val("");
        startDate = "";
        endDate = "";
    }

    // Clear Button
    $("#clearButton").on("click", function () {
        $("#searchKeywordInput").val("");
        $("#searchResults").empty();
        $("#exportSection").addClass("d-none");
        $("#filtersSortersContainer").addClass("d-none");
        $(".matching-docs-count").addClass("d-none"); 
        $(".results-text").removeClass("d-none");
        clearFilters();
    });

    function exportToCSV(data) {
        let csvContent = "data:text/csv;charset=utf-8,";
        csvContent += "File Name,Match Count,Snippets\n";

        data.forEach(doc => {
            const totalMatches = doc.snippets.reduce((acc, snip) => acc + (snip.match(/<mark>/g) || []).length, 0);
            const flatSnippets = doc.snippets.map(s => s.replace(/(<([^>]+)>)/gi, "")).join(" | "); // remove HTML
            csvContent += `"${doc.fileName}",${totalMatches},"${flatSnippets}"\n`;
        });

        const encodedUri = encodeURI(csvContent);
        const link = document.createElement("a");
        link.setAttribute("href", encodedUri);
        link.setAttribute("download", "search_results.csv");
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }

    $("#exportCsvBtn").on("click", function (e) {
        e.preventDefault();
        exportToCSV(latestSearchResults);
    });

    $("#exportPdfBtn").on("click", function () {
        // Extract data from current results
        const keyword = $("#searchKeywordInput").val();
        const results = [];

        $("#searchResults .card").each(function () {
            const fileName = $(this).find(".card-header strong").text().trim();
            const matchText = $(this).find(".card-header .text-muted").text();
            const matchCount = parseInt(matchText.match(/\d+/)[0]);

            const snippets = [];
            $(this).find(".list-group-item").each(function () {
                // Skip the item if it contains the "View all matches" link
                const anchor = $(this).find("a.toggle-snippets-link");
                if (anchor.length === 0) {
                    snippets.push($(this).html().trim());
                }
            });

            results.push({
                fileName,
                matchCount,
                snippets
            });
        });

        // Send to backend
        $.ajax({
            url: '/Home/ExportToPdf',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                keyword,
                results
            }),
            xhrFields: {
                responseType: 'blob'  // so we can download the PDF
            },
            success: function (blob) {
                const link = document.createElement('a');
                link.href = window.URL.createObjectURL(blob);
                link.download = "ElasticFind_Results.pdf";
                link.click();
            },
            error: function () {
                alert("Failed to export PDF");
            }
        });
    });



</script>