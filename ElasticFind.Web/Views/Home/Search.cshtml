@{
    ViewData["Title"] = "Search";
    Layout = "_Layout";
}

<head>
    <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/jQuery-QueryBuilder/dist/css/query-builder.default.min.css">
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
</head>

<body>
    <h3 class="mb-4" style="color: #305796;">Search Documents</h3>

    <div id="builder" class="mb-3"></div>
    <button id="btnSearch" class="btn btn-primary mb-3 pointer">Query Search</button>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
        <h3 class="results-text me-3" style="color: #3f629b;">Your Results Go Here</h3>
        <h4 class="matching-docs-count d-none" style="color: #3f629b;">Found <span id="matchingDocsCountSpan"> matching
                documents</span></h4>
        </div>
        <div class="sorter-container d-flex align-items-center d-none">
            <div class="fs-5" style="font-weight: 500;">Sort By: </div>
            <select class="select-sorter form-select form-select-sm ms-2 pointer" style="width: 160px;"
                id="sortBySelect">
                <option value="1" selected>Date (Descending)</option>
                <option value="3">Date (Ascending)</option>
                <option value="2">File Type</option>
            </select>
        </div>
    </div>

    <div id="searchResults" class="mt-4" style="max-height: 45vh; overflow-y: auto;">

    </div>

    <div class="pagination-container d-flex justify-content-between align-items-center d-none mt-3">
        <div class="items-per-page d-flex align-items-center">
            <label for="itemsPerPageSelect" class="me-2">Items per page:</label>
            <select id="itemsPerPageSelect" class="form-select form-select-sm pointer" style="width: 100px;">
                <option value="5" selected>5</option>
                <option value="10">10</option>
                <option value="20">20</option>
                <option value="50">50</option>
            </select>
        </div>
        <div class="pagination-buttons d-flex align-items-center">
            <span class="me-2">Showing <span id="startPage"></span> - <span id="endPage"></span> of <span
                    id="totalDocuments"></span></span>
            <button type="button" class="btn btn-sm btn-outline-primary me-2" id="firstPageButton" title="First Page">
                <i class="bi bi-chevron-double-left"></i>
            </button>
            <button type="button" class="btn btn-sm btn-outline-primary me-2" id="previousPageButton"
                title="Previous Page">
                <i class="bi bi-chevron-left"></i>
            </button>
            <button type="button" class="btn btn-sm btn-outline-primary me-2" id="nextPageButton" title="Next Page">
                <i class="bi bi-chevron-right"></i>
            </button>
            <button type="button" class="btn btn-sm btn-outline-primary" id="lastPageButton" title="Last Page">
                <i class="bi bi-chevron-double-right"></i>
            </button>
        </div>
    </div>

    <div id="exportSection" class="mt-3 d-none">
        <button class="btn btn-primary" type="button" id="exportToPdfBtn" aria-expanded="false">
            Export Results
            <img src="~/images/export-white.png" alt="Export Icon" class="ms-1 mb-1" style="width: 20px; height: 20px;">
        </button>
    </div>

    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jQuery-QueryBuilder/dist/js/query-builder.standalone.min.js"></script>
    <script src="~/js/query-builder-elasticsearch.js"></script>
</body>

<!-- Preview Modal -->
<div class="modal fade" id="previewModal" tabindex="-1" aria-labelledby="previewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="previewModalLabel">Preview File</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0" style="height: 80vh;">
                <iframe id="onlyofficeFrame" style="width: 100%; height: 100%; border: none;"></iframe>
            </div>
        </div>
    </div>
</div>

<!-- Loader -->

<div id="loader"
    class="position-fixed top-0 start-0 w-100 h-100 justify-content-center align-items-center bg-white bg-opacity-75"
    style="display: none; z-index: 9999;">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Searching...</span>
    </div>
</div>

<script>
    currentPage = 1;
    currentPageSize = 5;

    var esBoolQuery = {};

    function searchDocumentContent() {
        var sortBy = $("#sortBySelect").val().trim();
        currentPageSize = $("#itemsPerPageSelect").val();
        console.log("Searching with parameters:", { sortBy: sortBy, currentPage: currentPage, currentPageSize: currentPageSize, esBoolQuery: JSON.stringify(esBoolQuery) });

        $("#loader").find(".spinner-border").removeClass("text-success").addClass("text-primary");
        @* $("#loader").show(); *@
            $("#loader").css("display", "flex");

        $.ajax({
            url: "/Home/SearchDocumentContent",
            type: "POST",
            data: { sortBy: sortBy, currentPage: currentPage, currentPageSize: currentPageSize, esBoolQuery: JSON.stringify(esBoolQuery) },
            success: function (data) {
                var html = "";
                console.log("Search results:", data);
                console.log("Data length:", data.searchResults.length);

                if (data.searchResults.length === 0) {
                    html = "<div class='alert alert-warning'>No results found.</div>";
                } else {
                    data.searchResults.forEach(function (doc, index) {
                        let totalHighlights = 0;
                        doc.snippets.forEach(snippet => {
                            totalHighlights += (snippet.match(/<mark>/g) || []).length;
                        });

                        html += `
                            <div class="card mb-4">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>${doc.highlightedFileName !== null ? doc.highlightedFileName : doc.fileName}</strong>
                                        <span class="total-doc-count text-muted ${totalHighlights == 0 ? 'd-none' : ''}"> - Found ${totalHighlights} match${totalHighlights === 1 ? '' : 'es'}</span>
                                    </div> 
                                    <div class="d-flex align-items-center">
                                    <div class="uploaded-date-text me-3">Uploaded at - <span class="uploaded-date">${doc.highlightedUploadedDate ? `<mark>${new Date(doc.uploadedDate).toLocaleDateString('en-GB')}</mark>` : new Date(doc.uploadedDate).toLocaleDateString('en-GB')}</span></div>
                                    <div class="pdf-exclude">
                                        <span class="d-flex align-items-center">
                                        <button class="btn btn-sm btn-outline-primary single-export-btn me-2"" data-id="${doc.id}" title="Export this search result">
                                            <i class="bi bi-file-earmark-arrow-up"></i>
                                        </button>
                                        <button onclick="downloadFile('${doc.id}', '${doc.fileName}')" class="btn btn-sm btn-outline-secondary me-2" title="Download">
                                            <i class="bi bi-download"></i>
                                        </button>
                                        @* <button class="btn btn-sm btn-outline-primary preview-btn" data-id="${doc.id}" title="Preview">
                                            <i class="bi bi-eye"></i>
                                        </button> *@
                                        </span>
                                    </div>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <ul class="list-group">
                        `;

                        doc.snippets.forEach(function (snippet, idx) {
                            const isHidden = idx >= 5 ? 'd-none extra-snippet' : '';
                            html += `<li class="list-group-item ${isHidden}" data-doc-index="${index}">${snippet}</li>`;
                        });

                        if (doc.snippets.length > 5) {
                            html += `
                                    <li class="list-group-item">
                                        <a href="#" class="toggle-snippets-link" data-doc-index="${index}" data-expanded="false">View all matches</a>
                                    </li>
                                `;
                        }

                        html += `
                                    </ul>
                                </div>
                            </div>
                        `;
                    });
                }

                $("#searchResults").html(html);

                $("#searchResults").scrollTop(0);
                @* document.getElementById("searchResults").scrollTo({
                    top: 0,
                    behavior: "smooth"
                }); *@

                if (data.searchResults.length > 0) {
                    $("#exportSection").removeClass("d-none");
                    $(".pagination-container").removeClass("d-none");
                    $(".sorter-container").removeClass("d-none");
                } else {
                    $("#exportSection").addClass("d-none");
                    $(".pagination-container").addClass("d-none");
                    $(".sorter-container").addClass("d-none");
                }

                $("#filtersSortersContainer").removeClass("d-none");
                $(".matching-docs-count").removeClass("d-none");
                $("#matchingDocsCountSpan").text(`${data.totalDocuments} matching document${data.totalDocuments === 1 ? '' : 's'}`);
                $(".results-text").addClass("d-none");
                $("#startPage").text((currentPage - 1) * currentPageSize + 1);
                $("#endPage").text(Math.min(currentPage * currentPageSize, data.totalDocuments));
                $("#totalDocuments").text(data.totalDocuments);
                if (currentPage === 1) {
                    $("#previousPageButton").prop("disabled", true);
                    $("#firstPageButton").prop("disabled", true);
                } else {
                    $("#previousPageButton").prop("disabled", false);
                    $("#firstPageButton").prop("disabled", false);
                }
                if (currentPage * currentPageSize >= data.totalDocuments) {
                    $("#nextPageButton").prop("disabled", true);
                    $("#lastPageButton").prop("disabled", true);
                } else {
                    $("#nextPageButton").prop("disabled", false);
                    $("#lastPageButton").prop("disabled", false);
                }
            },
            error: function (xhr) {
                $("#searchResults").html("<div class='alert alert-danger'>An error occurred while searching.</div>");
            },
            complete: function () {
                @* $("#loader").css("display", "none"); *@
                    $("#loader").hide();
            }
        });
    }

    $(document).on("keydown", ".rule-value-container input", function (e) {
        if (e.key === "Enter") {
            e.preventDefault();
            currentPage = 1;
            var rules = $('#builder').queryBuilder('getRules');
            console.log("Rules: ", rules);
            var esQuery = $('#builder').queryBuilder('getESBool');
            console.log("ES Query: ", esQuery);
            if (esQuery && Object.keys(esQuery).length > 0) {
                esBoolQuery = esQuery;
            }
            searchDocumentContent();
        }

        if (e.key === "Tab") {
            e.preventDefault();
            const $nearestAddRuleButton = $(this)
                .closest(".rules-group-container")
                .find(".rules-group-header [data-add='rule']"); 
            if ($nearestAddRuleButton.length) {
                $nearestAddRuleButton.click();
            }
        }

        if (e.key === "Delete") {
            e.preventDefault();
            const $nearestDeleteRuleButton = $(this)
                .closest(".rule-container")
                .find("[data-delete='rule']");  
            if ($nearestDeleteRuleButton.length) {
                $nearestDeleteRuleButton.click();
            }
        }

        if (e.key === "q") {
            e.preventDefault();
            const $nearestAddGroupButton = $(this)
                .closest(".rules-group-container")
                .find(".rules-group-header [data-add='group']"); 
            if ($nearestAddGroupButton.length) {
                $nearestAddGroupButton.click();
            }
        }

        @* if (e.key === "Backspace") {
            e.preventDefault();
            const $nearestDeleteGroupButton = $(this)
                .closest(".rules-group-container")
                .find(".rules-group-header [data-delete='group']"); 
            if ($nearestDeleteGroupButton.length) {
                $nearestDeleteGroupButton.click();
            }
        } *@
    });

    $(document).on("change", "#sortBySelect", function () {
        currentPage = 1;
        searchDocumentContent();
    });

    // Toggle snippets visibility
    $(document).on("click", ".toggle-snippets-link", function (e) {
        e.preventDefault();
        const link = $(this);
        const index = link.data("doc-index");
        const expanded = link.data("expanded");

        if (!expanded) {
            $(`li.extra-snippet[data-doc-index='${index}']`).removeClass("d-none");
            link.text("Show less");
            link.data("expanded", true);
        } else {
            $(`li.extra-snippet[data-doc-index='${index}']`).addClass("d-none");
            link.text("View all matches");
            link.data("expanded", false);
        }
    });

    //Preview Button
    $(document).on("click", ".preview-btn", function () {
        const fileId = $(this).data("id");
        console.log("Previewing file with ID:", fileId);

        @* $("#onlyofficeFrame").attr("src", `/Home/OnlyOfficeViewerPage?id=${fileId}`); *@
            window.location.href = `/Home/OnlyOfficeViewerPage?id=${fileId}`;
        @* $("#previewModal").modal("show"); *@
    });

    function exportToCSV(data) {
        let csvContent = "data:text/csv;charset=utf-8,";
        csvContent += "File Name,Match Count,Snippets\n";

        data.forEach(doc => {
            const totalMatches = doc.snippets.reduce((acc, snip) => acc + (snip.match(/<mark>/g) || []).length, 0);
            const flatSnippets = doc.snippets.map(s => s.replace(/(<([^>]+)>)/gi, "")).join(" | "); // remove HTML
            csvContent += `"${doc.fileName}",${totalMatches},"${flatSnippets}"\n`;
        });

        const encodedUri = encodeURI(csvContent);
        const link = document.createElement("a");
        link.setAttribute("href", encodedUri);
        link.setAttribute("download", "search_results.csv");
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }

    $("#exportToPdfBtn").on("click", function () {
        $("#loader").find(".spinner-border").removeClass("text-primary").addClass("text-success");
        $("#loader").show();

        // Extract data from current results
        var searchType = $("#searchTypeSelect").val();
        if (searchType == "1") {
            searchType = "Full-Text Search";
        } else if (searchType == "2") {
            searchType = "Multiple-Text Search";
        } else if (searchType == "3") {
            searchType = "Fuzzy Search";
        } else if (searchType == "4") {
            searchType = "Synonym Search";
        }
        const keyword = $("#searchKeywordInput").val();
        const fileType = $("#fileTypeFilter").val().replace(".", "");
        var sortBy = $("#sortBySelect").val();
        if (sortBy == "1") {
            sortBy = "Date (Descending)";
        } else if (sortBy == "2") {
            sortBy = "File Type";
        } else if (sortBy == "3") {
            sortBy = "Date (Ascending)";
        } else {
            sortBy = "No sorting";
        }
        const searchString = $("#searchInput").val() || null;
        if (!startDate || !endDate) {
            startDate = null;
            endDate = null;
        }
        const results = [];

        $("#searchResults .card").each(function () {
            const fileName = $(this).find(".card-header strong").text().trim();
            const matchText = $(this).find(".card-header .text-muted").text();
            const matchCount = parseInt(matchText.match(/\d+/)[0]);

            const snippets = [];
            $(this).find(".list-group-item").each(function () {
                // Skip the item if it contains the "View all matches" link
                const anchor = $(this).find("a.toggle-snippets-link");
                if (anchor.length === 0) {
                    snippets.push($(this).html().trim());
                }
            });

            results.push({
                fileName,
                matchCount,
                snippets
            });
        });
        console.log("Exporting filters:", {
            searchType, keyword, fileType, startDate, endDate, sortBy, searchString, results
        });
        // Send to backend
        $.ajax({
            url: '/Home/ExportToPdf',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                searchType, keyword, fileType, startDate, endDate, sortBy, searchString, results
            }),
            xhrFields: {
                responseType: 'blob'  // so we can download the PDF
            },
            success: function (blob) {
                const link = document.createElement('a');
                link.href = window.URL.createObjectURL(blob);
                link.download = "ElasticFind_Results.pdf";
                link.click();
            },
            error: function () {
                alert("Failed to export PDF");
            },
            complete: function () {
                $("#loader").hide();
            }
        });
    });

    $(document).on("click", ".single-export-btn", function () {
        $("#loader").find(".spinner-border").removeClass("text-primary").addClass("text-success");
        $("#loader").show();

        var searchType = $("#searchTypeSelect").val();
        if (searchType == "1") {
            searchType = "Full-Text Search";
        } else if (searchType == "2") {
            searchType = "Multiple-Text Search";
        } else if (searchType == "3") {
            searchType = "Fuzzy Search";
        } else if (searchType == "4") {
            searchType = "Synonym Search";
        }
        const keyword = $("#searchKeywordInput").val();
        const fileType = $("#fileTypeFilter").val().replace(".", "");
        var sortBy = $("#sortBySelect").val();
        if (sortBy == "1") {
            sortBy = "Date (Ascending)";
        } else if (sortBy == "2") {
            sortBy = "File Type";
        } else if (sortBy == "3") {
            sortBy = "Date (Ascending)";
        } else {
            sortBy = "No sorting";
        }
        const searchString = $("#searchInput").val() || null;
        if (!startDate || !endDate) {
            startDate = null;
            endDate = null;
        }

        const results = [];

        $(this).closest(".card").each(function () {
            const fileName = $(this).find(".card-header strong").text().trim();
            const matchText = $(this).find(".card-header .text-muted").text();
            const matchCount = parseInt(matchText.match(/\d+/)[0]);

            const snippets = [];
            $(this).find(".list-group-item").each(function () {
                // Skip the item if it contains the "View all matches" link
                const anchor = $(this).find("a.toggle-snippets-link");
                if (anchor.length === 0) {
                    snippets.push($(this).html().trim());
                }
            });

            results.push({
                fileName,
                matchCount,
                snippets
            });
        });
        console.log("Exporting filters in single export:", {
            searchType, keyword, fileType, startDate, endDate, sortBy, searchString, results
        });
        // Send to backend
        $.ajax({
            url: '/Home/ExportToPdf',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                searchType, keyword, fileType, startDate, endDate, sortBy, searchString, results
            }),
            xhrFields: {
                responseType: 'blob'  // so we can download the PDF
            },
            success: function (blob) {
                const link = document.createElement('a');
                link.href = window.URL.createObjectURL(blob);
                link.download = "ElasticFind_Results.pdf";
                link.click();
            },
            error: function () {
                alert("Failed to export PDF");
            },
            complete: function () {
                $("#loader").hide();
            }
        });
    });

    function downloadFile(fileId, fileName) {
        $("#loader").find(".spinner-border").removeClass("text-success").addClass("text-primary");
        $("#loader").show();

        $.ajax({
            url: `/Home/Download/${fileId}`,
            method: "GET",
            xhrFields: {
                responseType: 'blob' // Get the raw binary data
            },
            success: function (data, status, xhr) {
                const blob = new Blob([data], { type: xhr.getResponseHeader('Content-Type') });
                const downloadUrl = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = downloadUrl;
                a.download = fileName;
                document.body.appendChild(a);
                a.click();
                a.remove();
                URL.revokeObjectURL(downloadUrl);
                console.log("successss!");
            },
            error: function () {
                alert("Error downloading file.");
            },
            complete: function () {
                $("#loader").hide();
            }
        });
    }

    $("#itemsPerPageSelect").on("change", function () {
        currentPage = 1;
        currentPageSize = $(this).val();
        searchDocumentContent();
    });

    $("#firstPageButton").on("click", function () {
        currentPage = 1;
        searchDocumentContent();
    });

    $("#previousPageButton").on("click", function () {
        if (currentPage > 1) {
            currentPage--;
            console.log("Current page:", currentPage);
            searchDocumentContent();
        }
    });

    $("#nextPageButton").on("click", function () {
        currentPage++;
        console.log("Current page:", currentPage);
        searchDocumentContent();
    });

    $("#lastPageButton").on("click", function () {
        currentPage = Math.ceil($("#totalDocuments").text() / currentPageSize);
        console.log("Current page on lastpagebutton click: ", currentPage);
        searchDocumentContent();
    });

    $.fn.queryBuilder.defaults({
        operators: [
            {
                type: 'equal',
                label: 'Equal',
                nb_inputs: 1,
                apply_to: ['string', 'number', 'datetime', 'boolean']
            },
            {
                type: 'not_equal',
                label: 'Not equal',
                nb_inputs: 1,
                apply_to: ['string', 'number', 'datetime', 'boolean']
            },
            {
                type: 'contains',
                label: 'Contains',
                nb_inputs: 1,
                apply_to: ['string']
            },
            {
                type: 'not_contains',
                label: 'Does not contain',
                nb_inputs: 1,
                apply_to: ['string']
            },
            {
                type: 'begins_with',
                label: 'Begins with',
                nb_inputs: 1,
                apply_to: ['string']
            },
            {
                type: 'not_begins_with',
                label: 'Does not begin with',
                nb_inputs: 1,
                apply_to: ['string']
            },
            {
                type: 'ends_with',
                label: 'Ends with',
                nb_inputs: 1,
                apply_to: ['string']
            },
            {
                type: 'not_ends_with',
                label: 'Does not end with',
                nb_inputs: 1,
                apply_to: ['string']
            },
            {
                type: 'in',
                label: 'In',
                nb_inputs: 1,
                apply_to: ['string', 'number']
            },
            {
                type: 'not_in',
                label: 'Not in',
                nb_inputs: 1,
                apply_to: ['string', 'number']
            },
            {
                type: 'is_in',
                label: 'Is In',
                nb_inputs: 1,
                apply_to: ['string', 'number', 'datetime', 'boolean']
            },
            {
                type: 'is_not_in',
                label: 'Is Not In',
                nb_inputs: 1,
                apply_to: ['string', 'number', 'datetime', 'boolean']
            },
            {
                type: 'fuzzy',
                label: 'Fuzzy Search',
                nb_inputs: 1,
                apply_to: ['string'],
                @* optgroup: 'Custom' *@
            },
        {
            type: 'less',
            label: 'Less than',
            nb_inputs: 1,
            apply_to: ['number', 'date', 'datetime']
        },
        {
            type: 'greater',
            label: 'Greater than',
            nb_inputs: 1,
            apply_to: ['number', 'date', 'datetime']
        },
        {
            type: 'between',
            label: 'Between',
            nb_inputs: 2,
            apply_to: ['number', 'date', 'datetime']
        }
        ]
    });

    $('#builder').queryBuilder({
        filters: [
            {
                id: 'attachment.content',
                label: 'Content',
                type: 'string',
                operators: [
                    'equal', 'not_equal', 'contains', 'not_contains',
                    'begins_with', 'not_begins_with',
                    'ends_with', 'not_ends_with',
                    'in', 'not_in', 'fuzzy'
                ]
            },
            {
                id: 'fileName.keyword',
                label: 'File Name',
                type: 'string',
                operators: [
                    'contains', 'not_contains',
                    'begins_with', 'not_begins_with',
                    'ends_with', 'not_ends_with'
                ]
            },
            {
                id: 'fileType.keyword',
                label: 'File Type',
                type: 'string',
                input: 'select',
                @* multiple: true, *@
            values: {
                '.pdf': 'pdf',
                '.docx,.doc': 'docx/dox',
                '.xlsx,.xls': 'xlsx/xls',
                '.txt': 'txt',
                '.pptx,.ppt': 'pptx/ppt',
                '.rtf': 'rtf',
                'Other': 'Other'
            },
            operators: ['in', 'not_in'] // - include this feature when we use multiple select
            },
        {
            id: 'uploadedDate',
            label: 'Upload Date',
            type: 'date',
            input: 'text',
            plugin: 'datepicker',
            plugin_config: {
                dateFormat: 'yy-mm-dd',
                changeMonth: true,
                changeYear: true
            },
            operators: ['equal', 'not_equal', 'less', 'greater', 'between']
        }
        ],
        default_filter: 'attachment.content',  // Set field by default
        allow_empty: true
    });

    $('#builder').on('afterCreateRuleInput.queryBuilder', function (e, rule) {
        if (rule.filter?.id === 'uploadedDate' && ['equal', 'less', 'greater'].includes(rule.operator.type)) {
            const $input = rule.$el.find('.rule-value-container input');
            const minDate = new Date('2020-01-01');
            const maxDate = new Date(); // today

            // Apply min/max limits
            $input.datepicker('option', 'minDate', minDate);
            $input.datepicker('option', 'maxDate', maxDate);

            $input.datepicker('setDate', maxDate); // default to today's date
        }

        if (rule.filter?.id === 'uploadedDate' && rule.operator.type === 'between') {
            const $inputs = rule.$el.find('.rule-value-container input');

            const $start = $inputs.eq(0);
            const $end = $inputs.eq(1);

            const minStart = new Date('2020-01-01');
            const maxEnd = new Date(); // today

            // Set min/max and default
            $start.datepicker('option', 'minDate', minStart);
            $start.datepicker('option', 'maxDate', maxEnd);
            $end.datepicker('option', 'maxDate', maxEnd);

            $start.datepicker('setDate', minStart); // default to 01-01-2000
            $end.datepicker('setDate', maxEnd); // default to today's date

            $start.on('change', function () {
                const startDate = $start.datepicker('getDate');
                if (startDate) {
                    $end.datepicker('option', 'minDate', startDate);
                }
            });

            $end.on('change', function () {
                const endDate = $end.datepicker('getDate');
                if (endDate) {
                    $start.datepicker('option', 'maxDate', endDate);
                }
            });
        }
    });

    $('#btnSearch').on('click', function () {
        currentPage = 1;
        var rules = $('#builder').queryBuilder('getRules');
        console.log("Rules: ", rules);
        var esQuery = $('#builder').queryBuilder('getESBool');
        console.log("ES Query: ", esQuery);
        if (esQuery && Object.keys(esQuery).length > 0) {
            esBoolQuery = esQuery;
        }
        searchDocumentContent();
    });
</script>