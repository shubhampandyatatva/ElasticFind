@{
    ViewData["Title"] = "Search";
    Layout = "_Layout";
}

<body>
    <h3 class="mb-4" style="color: #305796;">Search Documents</h3>

    <div class="search-type d-flex align-items-center mb-4">
        <div class="fs-5 me-3" style="font-weight: 450; color: rgb(61, 58, 58)">Select Search Type: </div>
        <select class="form-select pointer" aria-label="Default select example"
            style="max-width: 300px; margin-right: 56px;" id="searchTypeSelect">
            <option value="1" class="pointer" title="Normal keyword search" selected>Normal Search</option>
            <option value="2" class="pointer" title="Search by multiple words separeted by space">Multiple-Text Search
            </option>
            <option value="3" class="pointer" title="Search with minor spelling errors or typos in keywords">Fuzzy
                Search</option>
            <option value="4" class="pointer" title="Search words with similar meanings">Synonym
                Search</option>
        </select>
        <div class="match-all-checkbox-container form-check form-check-lg d-none">
            <input class="form-check-input pointer" type="checkbox" id="matchAllCheckbox">
            <label class="match-all-terms-label form-check-label ms-1" for="matchAllCheckbox">
                Match All Terms
            </label>
        </div>
    </div>

    <div class="d-flex flex-column flex-md-row align-items-start gap-3 mb-4">
        <input type="text" class="form-control flex-grow-1" id="searchKeywordInput" placeholder="Enter keyword...">
        <div class="buttons d-flex align-items-center">
            <button type="button" class="btn btn-primary me-2" id="searchKeywordBtn">Search</button>
            <button type="button" class="btn btn-outline-primary" id="clearButton">Clear</button>
        </div>
    </div>

    <div class="info-text mb-4 d-none" style="color: rgb(128, 128, 0);">Enter more than two characters for best results
    </div>

    <div class="d-flex align-items-center mb-4">
        <h3 class="results-text me-3" style="color: #3f629b;">Your Results Go Here</h3>
        <h4 class="matching-docs-count d-none" style="color: #3f629b;">Found <span id="matchingDocsCountSpan"> matching
                documents</span></h4>
    </div>

    @* <button type="button" class="btn btn-primary" id="createDocumentBtn">Create Document</button> *@ 

