@{
    Layout = null;
}
@model ElasticFind.Repository.ViewModels.ExportResultViewModel

<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />
    <title>ElasticFind Search Results</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #fff;
            color: #333;
            font-size: 14px;
            line-height: 1.5;
            padding: 20px;
        }

        .card {
            border: 1px solid #ccc;
            border-radius: 8px;
            margin-bottom: 20px;
            box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.05);
        }

        .card-header {
            padding: 10px 15px;
            border-bottom: 1px solid #ddd;
            background-color: #f8f9fa;
            font-weight: bold;
            display: flex !important;
            @* justify-content: space-between !important; *@
            @* align-items: center !important; *@
        }

        .card-body {
            padding: 15px;
        }

        .list-group {
            padding-left: 0;
            margin-bottom: 0;
            border-radius: 0.25rem;
        }

        .list-group-item {
            position: relative;
            display: block;
            padding: 0.75rem 1.25rem;
            background-color: #fff;
            border: 1px solid #bebebe;
            @* border-radius: 0.25rem; *@
        }

        .text-muted {
            color: #6c757d;
        }

        strong {
            font-weight: 600;
        }

        .toggle-snippets-link {
            display: inline-block;
            margin-top: 5px;
            color: #007bff;
            text-decoration: none;
        }

        .toggle-snippets-link:hover {
            text-decoration: underline;
        }

        .pdf-exclude {
            display: none;
        }

        h2 {
            font-size: 20px;
            color: #305796;
            margin-bottom: 25px;
        }

        .filters-section {
            margin-bottom: 20px;
            padding: 10px;
            background-color: #f1f1f1;
            border-radius: 5px;
            border: 1px solid #ddd;
            display: flex;
            align-items: center;
        }

        .filter-text {
            font-weight: bolder;
            color: #333;
            margin-bottom: 10px;
            margin-right: 6px;
            font-size: 16px;
        }

        .filter-type {
            font-weight: 600;
            margin-bottom: 10px;
            font-size: 14px;
        }

        .filter-name {
            color: #333;
            margin-bottom: 10px;
            margin-right: 4px;
            font-size: 14px;
        }
    </style>
</head>

<body>
    @* <h2>Search Results for "@Model.Keyword"</h2> *@
    <h2>ElasticFind - Search Results</h2>

    @* <div class="searchType" style="margin-bottom: 16px; font-size: 16px; font-weight: bold;">Search Method: <span style="color: #333; font-weight: 500;">@Model.SearchType</span></div> *@

    <div class="filters-section">
        @* <span class="filter-text">Filters: </span>
        <span class="filters" style="display: flex; align-items: center;">
            <span class="filter-type">File Type: </span>
            <span class="filter-name">@(Model.FileType == null || Model.FileType == "File Type" ? "All Types" : Model.FileType)</span>
        </span>
        <span class="filters">
            <span class="filter-type">Date Range: </span>
            <span class="filter-name">@(Model.StartDate != null ? $"{Model.StartDate?.ToString("dd-MM-yyyy")} to {Model.EndDate?.ToString("dd-MM-yyyy")}" : "All Time")</span>
        </span> *@
        <span class="filters">
            <span class="filter-type">Sorted By: </span>
            <span class="filter-name">@(Model.SortBy)</span>
        </span>
        @* <span class="filters">
            <span class="filter-type">File Name: </span>
            <span class="filter-name">@(Model.SearchString ?? "All")</span>
        </span> *@
    </div>

    <h3 style="color: #305796; font-size: 18px; @(Model.TotalDocumentsCount == 0 ? "display: none" : "")">Found
        @Model.TotalDocumentsCount matching documents</h3>

    @foreach (var doc in Model.Results)
    {
        <div class="card">
            <div class="card-header">
                <div>odf demo.odt - Found 1 match</div>
                <div>Uploaded at - 2025-07-22</div>
            </div>
            @* <div class="card-header">
                <div>@Html.Raw(doc.FileName) <span style="@(doc.MatchCount == 0 ? "display: none" : "")">- Found @doc.MatchCount match@(doc.MatchCount == 1 ? "" : "es")</span></div>
                <div>@Html.Raw(doc.UploadedDateText)</div>
            </div> *@
            <div class="card-body">
                <ul class="list-group">
                    @foreach (var snippet in doc.Snippets)
                    {
                        <li class="list-group-item">@Html.Raw(snippet)</li>
                    }
                </ul>
            </div>
        </div>
    }
</body>

</html>
