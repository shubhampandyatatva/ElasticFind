@model ElasticFind.Repository.ViewModels.DisplayFilesViewModel

<div class="table-responsive">
    <table class="table">
        <thead>
            <th style="width: 8%;">Sr. No</th>
            <th style="width: 82%;">File Name</th>
            <th style="width: 10%;" class="text-center">Actions</th>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Files.Count; i++)
            {
                <tr>
                    <td>@(i + 1)</td>
                    <td>@Model.Files[i].FileName</td>
                    <td class="text-center">
                        <span class="d-flex justify-content-center align-items-center">
                            <i class="fa fa-download me-4 pointer"
                                onclick="window.location.href='/Home/Download/@Model.Files[i].Id'" data-toggle="tooltip"
                                data-placement="bottom" title="Download File"></i>
                            <i class="fa fa-trash pointer" data-bs-toggle="modal" data-bs-target="#delete_file_modal"
                                data-toggle="tooltip" data-placement="bottom" title="Delete File"
                                data-user-id="@Model.Files[i].Id" onclick="setUserId('@Model.Files[i].Id')"></i>
                        </span>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="6">
                    <div class="d-flex justify-content-end align-items-center">
                        <span class="me-2">Items per page:</span>
                        <select class="pointer" id="itemsPerPage" onchange="changePageSize()">
                            <option value="5" selected=@(Model.Pagination.PageSize == 5 ? "selected" : null)>5
                            </option>
                            <option value="10" selected=@(Model.Pagination.PageSize == 10 ? "selected" : null)>10
                            </option>
                            <option value="15" selected=@(Model.Pagination.PageSize == 15 ? "selected" : null)>
                                15</option>
                        </select>
                        <span class="ms-2">Showing @(Model.Pagination.PageSize *
                                                        (Model.Pagination.Page - 1) + 1) -
                            @((Model.Pagination.PageSize * Model.Pagination.Page) >
                                                        Model.Pagination.TotalRecords ? Model.Pagination.TotalRecords :
                                                        (Model.Pagination.PageSize * Model.Pagination.Page)) of
                            @Model.Pagination.TotalRecords</span>

                        <button class="btn btn-outline-secondary ms-2 @(Model.Pagination.Page > 1 ? "" : "disabled")"
                            onclick="loadPrevPage()">
                            &lt;
                        </button>

                        <button
                            class="btn btn-outline-secondary ms-2 @(Model.Pagination.Page* Model.Pagination.PageSize < Model.Pagination.TotalRecords ? "" : "disabled")"
                            onclick="loadNextPage()">
                            &gt;
                        </button>
                    </div>
                </td>
            </tr>
        </tfoot>
    </table>
</div>

<script>
    function loadPrevPage() {
        var page = @Model.Pagination.Page - 1;
        var pageSize = @Model.Pagination.PageSize;
        var searchString = $("#searchInput").val();
        var sortOrder = $(this).data("order");
        loadPage(page, pageSize, searchString, null);
    }

    function loadNextPage() {
        var page = @Model.Pagination.Page + 1;
        var pageSize = @Model.Pagination.PageSize;
        var searchString = $("#searchInput").val();
        var sortOrder = $(this).data("order");
        loadPage(page, pageSize, searchString, null);
    }    
</script>