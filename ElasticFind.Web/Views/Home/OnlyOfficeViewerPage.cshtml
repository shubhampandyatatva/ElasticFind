@{
    Layout = null;
    var fileId = Context.Request.Query["id"];
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>OnlyOffice Viewer</title>
    <script src="http://localhost/web-apps/apps/api/documents/api.js"></script>
    <style>
        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
            overflow: hidden;
        }
        #placeholder {
            width: 100%;
            height: 100%;
        }
    </style>
</head>
<body>
    <div id="placeholder"></div>

    <script>
        const fileId = '@fileId';
        console.log("File ID:", fileId);

        fetch(`/Home/OnlyOfficeViewer?id=${fileId}`)
            .then(response => response.json())
            .then(config => {
                console.log("Viewer config:", config);
                new DocsAPI.DocEditor("placeholder", config);
            })
            .catch(err => {
                document.body.innerHTML = "<h4 style='color: red;'>Error loading document</h4>";
                console.error(err);
            });
    </script>
</body>
</html>