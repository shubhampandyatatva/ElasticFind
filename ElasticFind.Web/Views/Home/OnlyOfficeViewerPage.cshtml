@{
    Layout = null;
    var fileId = Context.Request.Query["id"];
}

<html>
<head>
    <meta charset="utf-8" />
    <title>Document Preview</title>
    <script src="http://localhost/web-apps/apps/api/documents/api.js"></script> 
    <script>
        const config = @Html.Raw(ViewBag.ConfigJson);
        console.log("Config:", config);
        config.token = "@ViewBag.Token";
        console.log("Token:", config.token);

        window.addEventListener("DOMContentLoaded", () => {
            const docEditor = new DocsAPI.DocEditor("placeholder", config);
        });
    </script>
</head>
<body>
    <div id="placeholder" style="width: 100%; height: 100vh;"></div>
</body>
</html>