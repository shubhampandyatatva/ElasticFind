@{
    ViewData["Title"] = "Admin Dashboard";
}
@model ElasticFind.Repository.ViewModels.DisplayFilesViewModel

<div class="container-fluid">
    <h2 class="mb-4" style="color: #305796;">Manage Files</h2>

    <form id="uploadForm" enctype="multipart/form-data" style="width: 100%; max-width: 550px;" class="mx-auto mb-4">
        <div class="category-container d-flex align-items-center mb-4">
            <label style="width: 360px;">Select Category for Upload:</label>
            <select class="form-select flex-grow-1" id="selectUploadCategory">
                <option value="">Select Category</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Name">@category.Name</option>
                }
            </select>
        </div>
        <div id="dropzone" class="upload-dropzone">
            <i class="fas fa-cloud-upload-alt"></i>
            <p class="mb-2">Drag & drop your files here</p>
            <p class="text-muted">or click to browse (PDF, DOC, TXT,...)</p>
            <input type="file" name="files" id="fileInput" class="hidden-input" accept=".pdf,.doc,.docx,.txt,.xlxs"
                multiple>

            <div id="fileNameDisplay" class="mt-3 text-center text-success fw-semibold"></div>
        </div>

        <div class="mt-4 d-grid">
            <button type="submit" class="btn btn-primary">Upload</button>
        </div>

        <div id="uploadProgressContainer" class="mt-3 d-none">
            <div class="progress">
                <div id="uploadProgressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                    role="progressbar" style="width: 100%">Uploading...</div>
            </div>
        </div>
    </form>

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h2 class="mb-0" style="color: #305796;">Your Files</h2>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div class="select-category d-flex align-items-center mb-2">
            <div class="select-category-text me-3">View files from: </div>
            <select class="form-select me-3" style="width: 200px;" id="selectCategory">
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Name">@category.Name</option>
                }
            </select>
            <button type="button" class="btn btn-primary" id="selectCategoryBtn">Search</button>
        </div>
        <div class="d-flex align-items-center">
            <i class="fa-solid fa-trash-can rounded pointer me-3 text-danger"
                style="padding: 10px; border: 2px solid rgb(49, 49, 49);" title="Delete selected files"
                id="deleteMultipleFilesBtn"></i>
            <div class="search position-relative" style="max-width: 400px;">
                <input type="text" id="searchInput" placeholder="Search Files" class="form-control pe-4"
                    title="Search files by name" />
                <img src="~/images/search-icon.svg" alt="Search Icon"
                    class="position-absolute top-50 translate-middle-y end-0 me-3" style="height: 18px;" />
            </div>
        </div>
    </div>

    <input type="hidden" id="allFileIdsJson" value='@Html.Raw(Json.Serialize(ViewBag.AllFileIds))' />

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div id="filesPartialView" style="max-height: 550px; overflow-x: auto;">
                @await Html.PartialAsync("_FilesPartial", Model)
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->

<div class="modal fade" id="delete_file_modal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle"
    aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">Delete File</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <!-- Content wrapper -->
            <div id="deleteModalContent">
                <div class="modal-body d-flex flex-column align-items-center">
                    <img src="~/images/warning-icon.svg" alt="Warning icon">
                    Are you sure you want to delete this file?
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-primary" id="deleteModalYesButton">Yes</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                </div>
            </div>

            <!-- Spinner wrapper -->
            <div id="deleteModalSpinner" class="d-none text-center p-4">
                <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>
                <div class="mt-3">Deleting file...</div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Multiple File Modal -->

<div class="modal fade" id="delete_multiple_file_modal" tabindex="-1" role="dialog"
    aria-labelledby="deleteMultipleFileModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteMultipleFileModalCenterTitle">Delete Selected Files</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <!-- Content wrapper -->
            <div id="deleteMultipleFilesModalContent">
                <div class="modal-body d-flex flex-column align-items-center">
                    <img src="~/images/warning-icon.svg" alt="Warning icon">
                    Are you sure you want to delete the selected files?
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-primary" id="deleteMultipleFilesYesBtn">Yes</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                </div>
            </div>

            <!-- Spinner wrapper -->
            <div id="deleteMultipleFilesModalSpinner" class="d-none text-center p-4">
                <div class="spinner-border text-danger" role="status" style="width: 3rem; height: 3rem;"></div>
                <div class="mt-3">Deleting file...</div>
            </div>
        </div>
    </div>
</div>

<!-- Download Loader -->

<div id="downloadLoader"
    class="position-fixed top-0 start-0 w-100 h-100 justify-content-center align-items-center bg-white bg-opacity-75"
    style="z-index: 9999; display: none;">
    <div class="spinner-border text-primary" role="status"></div>
</div>

<script>
    const dropzone = document.getElementById('dropzone');
    const fileInput = document.getElementById('fileInput');
    const fileNameDisplay = document.getElementById('fileNameDisplay');

    let allFiles = [];

    function updateFileNameDisplay(files) {
        if (files.length > 0) {
            const names = files.map(f => f.name).join(', ');
            fileNameDisplay.innerHTML = `<strong>Selected Files: </strong>${names}`;
        } else {
            fileNameDisplay.textContent = '';
        }
    }

    dropzone.addEventListener('click', function () {
        if ($(".category-container select").val() === "") {
            toastr.warning("Please select a category for uploading the files.", "Warning");
            return;
        }
        fileInput.click();
    });

    // Handle click selection
    fileInput.addEventListener('change', () => {
        const selectedFiles = Array.from(fileInput.files);

        // Filter out duplicates (optional)
        const existingFileNames = new Set(allFiles.map(f => f.name));
        const newUniqueFiles = selectedFiles.filter(f => !existingFileNames.has(f.name));

        allFiles = allFiles.concat(newUniqueFiles); // Append only new ones
        updateFileNameDisplay(allFiles);

        // Reset input so same file can be selected again if needed
        fileInput.value = '';
    });

    // Drag styling
    dropzone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropzone.classList.add('dragover');
    });

    dropzone.addEventListener('dragleave', () => {
        dropzone.classList.remove('dragover');
    });

    dropzone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropzone.classList.remove('dragover');

        const droppedFiles = Array.from(e.dataTransfer.files);
        allFiles = allFiles.concat(droppedFiles); // append to existing
        updateFileNameDisplay(allFiles);
    });

    var SortOrder = null;
    let allFileIds = JSON.parse($("#allFileIdsJson").val() || "[]");
    console.log("allFileIds: ", allFileIds);
    let selectedFileIds = new Set();
    let currentPage = @Model.Pagination.Page;
    let currentPageSize = @Model.Pagination.PageSize;
    var selectedCategoryGlobal = $("#selectCategory").val() || "";

    // Master checkbox change
    $(document).on("change", "#masterCheckbox", function () {
        const isChecked = $(this).is(":checked");

        if (isChecked) {
            allFileIds.forEach(id => selectedFileIds.add(id));
            console.log("allFileIds: ", allFileIds);
        } else {
            selectedFileIds.clear();
            console.log("allFileIds: ", allFileIds);
        }

        $(".slaveCheckbox").each(function () {
            const fileId = $(this).data("id");
            console.log("Master checkbox changed for fileId: ", fileId);
            $(this).prop("checked", isChecked);
        });
    });

    // Individual slave checkbox change
    $(document).on("change", ".slaveCheckbox", function () {
        const fileId = $(this).data("id");

        if ($(this).is(":checked")) {
            selectedFileIds.add(fileId);
        } else {
            selectedFileIds.delete(fileId);
        }

        // Update master checkbox to reflect partial/complete state
        updateMasterCheckboxState();
    });

    async function loadPage(selectedCategory, page, pageSize, searchString, sortOrder) {
        console.log(selectedCategory, page, pageSize, searchString, sortOrder);
        try {
            const data = await $.ajax({
                url: "/Home/Index",
                type: "GET",
                data: { selectedCategory: selectedCategory, page: page, pageSize: pageSize, searchString: searchString, sortOrder: sortOrder }
            });

            $("#filesPartialView").html(data);

            allFileIds = JSON.parse($("#allFileIdsJson").val() || "[]");

            console.log("Updated allFileIds: ", allFileIds);
            // Update state variables
            currentPage = page;
            currentPageSize = pageSize;

            // Restore checkbox states after new content
            restoreCheckedCheckboxes();

        } catch (err) {
            console.error("Error loading page: ", err);
        }
    }

    function restoreCheckedCheckboxes() {
        $(".slaveCheckbox").each(function () {
            const fileId = $(this).data("id");
            if (selectedFileIds.has(fileId)) {
                $(this).prop("checked", true);
            }
        });

        updateMasterCheckboxState();
    }

    function updateMasterCheckboxState() {
        const masterCheckbox = $("#masterCheckbox").get(0);

        const totalIds = allFileIds.length;
        const selectedIdsCount = selectedFileIds.size;

        if (selectedIdsCount === 0) {
            masterCheckbox.indeterminate = false;
            masterCheckbox.checked = false;
        } else if (selectedIdsCount === totalIds) {
            masterCheckbox.indeterminate = false;
            masterCheckbox.checked = true;
        } else {
            masterCheckbox.indeterminate = true;
            masterCheckbox.checked = false;
        }
    }

    $("#uploadForm").on("submit", function (e) {
        e.preventDefault();

        var uploadCategory = $("#selectUploadCategory").val();

        if (uploadCategory === "") {
            toastr.warning("Please select a category for uploading the files.", "Warning");
            return;
        }

        if (allFiles.length === 0) {
            toastr.warning("Please select files to upload.", "Warning");
            return;
        }

        var formData = new FormData();

        // Append each file from allFiles array
        allFiles.forEach(file => {
            formData.append("files", file);
        });

        // If any of the files is empty,#305796 display a warning message.
        if (allFiles.some(file => file.size === 0)) {
            toastr.warning("One or more selected files are empty. Only non-empty files will be uploaded.", "Warning");
        }

        formData.append("uploadCategory", uploadCategory);

        var pageSize = $("#itemsPerPage").val();
        var searchString = $("#searchInput").val();

        $("#downloadLoader").find(".spinner-border").removeClass("text-success").addClass("text-primary");
        $("#downloadLoader").css("display", "flex");

        var selectedCategory = $(".select-category select").val();

        $.ajax({
            url: "/Home/UploadDocuments",
            type: "POST",
            data: formData,
            processData: false,
            contentType: false,
            success: function (response) {
                if (response.success) {
                    console.log("Upload response: ", response);
                    $("#selectCategory").val(uploadCategory);
                    selectedCategoryGlobal = uploadCategory;
                    $("#searchInput").val("");
                    loadPage(selectedCategoryGlobal, 1, pageSize, null, SortOrder);
                    toastr.success(response.message, "Success");
                    allFiles = []; // reset after successful upload
                    updateFileNameDisplay([]);
                    $("#downloadLoader").hide();
                }
                else {
                    console.log("Upload error else response: ", response);
                    if (typeof response === "string") { //html error page is returned in response
                        toastr.error("Your JWT Token is expired! Please login again!", "Error");
                        $("#downloadLoader").hide();
                    }
                    toastr.error(response.message.length > 100 ? "Some unknown error occured! Please try again" : response.message, "Error");
                    $("#downloadLoader").hide();
                }
            },
            error: function (xhr) {
                toastr.error(xhr.responseText.length > 10 ? "Try again after some time" : xhr.responseText, "Error");
                console.error("Upload error: ", xhr.responseText);
                $("#downloadLoader").hide();
            }
        });
    });

    function changePageSize() {
        var pageSize = $("#itemsPerPage").val();
        var searchString = $("#searchInput").val();
        loadPage(selectedCategoryGlobal, 1, pageSize, searchString, SortOrder);
    }

    $("#searchInput").on("input", function () {
        var searchString = $(this).val();
        var pageSize = $("#itemsPerPage").val();
        loadPage(selectedCategoryGlobal, 1, pageSize, searchString, SortOrder);
    });

    var fileId;
    function setUserId(id) {
        fileId = id;
    }

    $(document).on("click", "#deleteModalYesButton", async function () {
        $("#deleteModalContent").addClass("d-none");
        $("#deleteModalSpinner").removeClass("d-none");

        var searchString = $("#searchInput").val();
        var pageSize = $("#itemsPerPage").val();

        selectedCategoryGlobal = $(".select-category select").val();
        console.log("Selected Category Global: ", selectedCategoryGlobal);

        try {
            const response = await $.ajax({
                url: "/Home/DeleteFile",
                type: "POST",
                data: { id: fileId, category: selectedCategoryGlobal }
            });

            if (response.success) {
                console.log("Success before loadPage");
                await loadPage(selectedCategoryGlobal, 1, pageSize, searchString, SortOrder);
                console.log("Success after loadPage");
                $('#delete_file_modal').modal('hide');
                toastr.success(response.message, "Success");
            } else {
                $('#delete_file_modal').modal('hide');
                toastr.error(response.message, "Error");
            }
        } catch (err) {
            $('#delete_file_modal').modal('hide');
            alert("An error occurred while deleting the file!");
            console.error(err);
        } finally {
            // Restore modal content
            $("#deleteModalContent").removeClass("d-none");
            $("#deleteModalSpinner").addClass("d-none");
        }
    });

    function downloadFile(fileId, fileName) {
        $("#downloadLoader").show();

        $.ajax({
            url: `/Home/Download?fileId=${fileId}&category=${selectedCategoryGlobal}`,
            method: "GET",
            xhrFields: {
                responseType: 'blob' // Get the raw binary data
            },
            success: function (data, status, xhr) {
                const blob = new Blob([data], { type: xhr.getResponseHeader('Content-Type') });
                const downloadUrl = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = downloadUrl;
                a.download = fileName;
                document.body.appendChild(a);
                a.click();
                a.remove();
                URL.revokeObjectURL(downloadUrl);
            },
            error: function () {
                alert("Error downloading file.");
            },
            complete: function () {
                $("#downloadLoader").hide();
            }
        });
    }

    $("#deleteMultipleFilesBtn").on("click", function () {
        const checkedFiles = $(".slaveCheckbox:checked");
        if (checkedFiles.length === 0) {
            toastr.warning("Please select some files to delete", "Warning");
            return;
        }
        console.log("Checked files: ", checkedFiles);
        $("#delete_multiple_file_modal").modal("show");
    });

    $("#deleteMultipleFilesYesBtn").on("click", async function () {
        const checkedFiles = $(".slaveCheckbox:checked");
        const fileIdsToDelete = [];
        checkedFiles.each(function () {
            fileIdsToDelete.push($(this).data("id"));
        });
        console.log("File IDs to delete: ", fileIdsToDelete);

        $("#deleteMultipleFilesModalContent").addClass("d-none");
        $("#deleteMultipleFilesModalSpinner").removeClass("d-none");

        selectedCategoryGlobal = $(".select-category select").val();
        console.log("Selected Category Global: ", selectedCategoryGlobal);

        try {
            const response = await $.ajax({
                url: "/Home/DeleteMultipleFiles",
                type: "POST",
                data: { ids: Array.from(selectedFileIds), category: selectedCategoryGlobal }
            });

            if (response.success) {
                toastr.success(response.message, "Success");
                loadPage(selectedCategoryGlobal, 1, $("#itemsPerPage").val(), null, SortOrder);
                selectedFileIds.clear();
                console.log("All File Ids after delete files: ", allFileIds);
                // Restore modal content
                $("#delete_multiple_file_modal").modal("hide");
            } else if (response.warning) {
                toastr.warning(response.message, "Warning");
                // Restore modal content
                $("#delete_multiple_file_modal").modal("hide");
            } else {
                toastr.error(response.message, "Error");
                // Restore modal content
                $("#delete_multiple_file_modal").modal("hide");
            }
        } catch (err) {
            $('#delete_multiple_file_modal').modal('hide');
            alert("An error occurred while deleting the files!");
            console.error(err);
        } finally {
            // Restore modal content
            $("#deleteMultipleFilesModalContent").removeClass("d-none");
            $("#deleteMultipleFilesModalSpinner").addClass("d-none");
        }
    });

    $("#selectCategoryBtn").on("click", function () {
        selectedCategoryGlobal = $(".select-category select").val();
        console.log("Selected Category: ", selectedCategoryGlobal);
        $(".selectedCategory").text(selectedCategoryGlobal);
        $("#searchInput").val("");
        loadPage(selectedCategoryGlobal, 1, $("#itemsPerPage").val(), $("#searchInput").val(), SortOrder);
    });
</script>
