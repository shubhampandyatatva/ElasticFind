@{
    ViewData["Title"] = "Admin Dashboard";
}
@model ElasticFind.Repository.ViewModels.DisplayFilesViewModel

<div class="container-fluid">
    <h2 class="mb-4" style="color: #305796;">Manage Files</h2>

    <form id="uploadForm" enctype="multipart/form-data" style="width: 100%; max-width: 550px;" class="mx-auto mb-4">
        <div id="dropzone" class="upload-dropzone">
            <i class="fas fa-cloud-upload-alt"></i>
            <p class="mb-2">Drag & drop your files here</p>
            <p class="text-muted">or click to browse (PDF, DOC, TXT)</p>
            <input type="file" name="files" id="fileInput" class="hidden-input" accept=".pdf,.doc,.docx,.txt,.xlxs"
                multiple>

            <div id="fileNameDisplay" class="mt-3 text-center text-success fw-semibold"></div>
        </div>

        <div class="mt-4 d-grid">
            <button type="submit" class="btn btn-primary">Upload</button>
        </div>

        <div id="uploadProgressContainer" class="mt-3 d-none">
            <div class="progress">
                <div id="uploadProgressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                    role="progressbar" style="width: 0%">0%</div>
            </div>
        </div>
    </form>

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h2 class="mb-0" style="color: #305796;">Your Files</h2>
        <div class="search position-relative" style="max-width: 400px;">
            <input type="text" id="searchInput" placeholder="Search" class="form-control pe-4" />
            <img src="~/images/search-icon.svg" alt="Search Icon"
                class="position-absolute top-50 translate-middle-y end-0 me-3 pointer" style="height: 18px;" />
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div id="filesPartialView" style="max-height: 320px; overflow-x: auto;">
                @await Html.PartialAsync("_FilesPartial", Model)
            </div>
        </div>
    </div>

    <div class="modal fade" id="delete_file_modal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle"
        aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLongTitle">Delete File</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <!-- Content wrapper -->
                <div id="deleteModalContent">
                    <div class="modal-body d-flex flex-column align-items-center">
                        <img src="~/images/warning-icon.svg" alt="Warning icon">
                        Are you sure you want to delete this file?
                    </div>
                    <div class="modal-footer justify-content-center">
                        <button type="button" class="btn btn-primary" id="deleteModalYesButton">Yes</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                    </div>
                </div>

                <!-- Spinner wrapper -->
                <div id="deleteModalSpinner" class="d-none text-center p-4">
                    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>
                    <div class="mt-3">Deleting file...</div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const dropzone = document.getElementById('dropzone');
    const fileInput = document.getElementById('fileInput');
    const fileNameDisplay = document.getElementById('fileNameDisplay');

    let allFiles = [];

    function updateFileNameDisplay(files) {
        if (files.length > 0) {
            const names = files.map(f => f.name).join(', ');
            fileNameDisplay.innerHTML = `<strong>Selected Files: </strong>${names}`;
        } else {
            fileNameDisplay.textContent = '';
        }
    }

    dropzone.addEventListener('click', () => fileInput.click());

    // Handle click selection
    fileInput.addEventListener('change', () => {
        const selectedFiles = Array.from(fileInput.files);

        // Filter out duplicates (optional)
        const existingFileNames = new Set(allFiles.map(f => f.name));
        const newUniqueFiles = selectedFiles.filter(f => !existingFileNames.has(f.name));

        allFiles = allFiles.concat(newUniqueFiles); // Append only new ones
        updateFileNameDisplay(allFiles);

        // Reset input so same file can be selected again if needed
        fileInput.value = '';
    });

    // Drag styling
    dropzone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropzone.classList.add('dragover');
    });

    dropzone.addEventListener('dragleave', () => {
        dropzone.classList.remove('dragover');
    });

    dropzone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropzone.classList.remove('dragover');

        const droppedFiles = Array.from(e.dataTransfer.files);
        allFiles = allFiles.concat(droppedFiles); // append to existing
        updateFileNameDisplay(allFiles);
    });

    var SortOrder = null;
    @* async function loadPage(page, pageSize, searchString, sortOrder) {
        console.log(page, pageSize, searchString, SortOrder);
        $.ajax({
            url: "/Home/Index",
            type: "GET",
            data: { page: page, pageSize: pageSize, searchString: searchString, sortOrder: SortOrder },
            success: function (data) {
                console.log("Success reached!");
                console.log("Partial view HTML:", data);
                $("#filesPartialView").html(data);
            },
            error: function (err) {
                console.error("Error loading page: ", err);
            }
        });
    } *@

        async function loadPage(page, pageSize, searchString, sortOrder) {
            console.log(page, pageSize, searchString, sortOrder);
            try {
                const data = await $.ajax({
                    url: "/Home/Index",
                    type: "GET",
                    data: { page: page, pageSize: pageSize, searchString: searchString, sortOrder: sortOrder }
                });

                console.log("Success reached!");
                console.log("Partial view HTML:", data);
                $("#filesPartialView").html(data);
            } catch (err) {
                console.error("Error loading page: ", err);
            }
        }


    $("#uploadForm").on("submit", function (e) {
        e.preventDefault();

        if (allFiles.length === 0) {
            alert("No files selected. Please select files to upload.");
            return;
        }

        var formData = new FormData();

        // Append each file from allFiles array
        allFiles.forEach(file => {
            formData.append("files", file);
        });

        var pageSize = $("#itemsPerPage").val();
        var searchString = $("#searchInput").val();

        $.ajax({
            url: "/Home/UploadDocuments",
            type: "POST",
            data: formData,
            processData: false,
            contentType: false,
            xhr: function () {
                var xhr = new window.XMLHttpRequest();

                xhr.upload.addEventListener("progress", function (evt) {
                    if (evt.lengthComputable) {
                        var percentComplete = Math.round((evt.loaded / evt.total) * 100);

                        // Show and update progress bar
                        $("#uploadProgressContainer").removeClass("d-none");
                        $("#uploadProgressBar")
                            .css("width", percentComplete + "%")
                            .text(percentComplete + "%");
                    }
                }, false);

                return xhr;
            },
            success: function (response) {
                loadPage(1, pageSize, searchString, SortOrder);
                toastr.success(response, "Success");
                allFiles = []; // reset after successful upload
                updateFileNameDisplay([]);

                // Reset progress bar
                $("#uploadProgressContainer").addClass("d-none");
                $("#uploadProgressBar").css("width", "0%").text("0%");
            },
            error: function (xhr) {
                toastr.error(response.message, "Error");
                $("#uploadProgressContainer").addClass("d-none");
            }
        });
    });

    function changePageSize() {
        var pageSize = $("#itemsPerPage").val();
        var searchString = $("#searchInput").val();
        loadPage(1, pageSize, searchString, SortOrder);
    }

    $("#searchInput").on("input", function () {
        var searchString = $(this).val();
        var pageSize = $("#itemsPerPage").val();
        loadPage(1, pageSize, searchString, SortOrder);
    });

    var fileId;
    function setUserId(id) {
        fileId = id;
    }

    @* $(document).on("click", "#deleteModalYesButton", function () {
        var searchString = $("#searchInput").val();
        var pageSize = $("#itemsPerPage").val();
        console.log("searchString:", searchString);
        console.log("pageSize:", pageSize);
        console.log("fileId:", fileId);

        $.ajax({
            url: "/Home/DeleteFile",
            type: 'POST',
            data: { id: fileId },
            success: function (response) {
                if (response.success) {
                    console.log("Success before loadPage");
                    await loadPage(1, pageSize, searchString, SortOrder);
                    console.log("Success after loadPage");
                    $('#delete_file_modal').modal('hide');
                    toastr.success(response.message, "Success");
                }
                else {
                    $('#delete_file_modal').modal('hide');
                    toastr.success(response.message, "Error");
                }
            },
            error: function () {
                $('#delete_file_modal').modal('hide');
                alert('An error occurred while deleting file!');
            }
        });
    }); *@

        $(document).on("click", "#deleteModalYesButton", async function () {
            $("#deleteModalContent").addClass("d-none");
            $("#deleteModalSpinner").removeClass("d-none");

            var searchString = $("#searchInput").val();
            var pageSize = $("#itemsPerPage").val();

            try {
                const response = await $.ajax({
                    url: "/Home/DeleteFile",
                    type: "POST",
                    data: { id: fileId }
                });

                if (response.success) {
                    console.log("Success before loadPage");
                    await loadPage(1, pageSize, searchString, SortOrder);
                    console.log("Success after loadPage");
                    $('#delete_file_modal').modal('hide');
                    toastr.success(response.message, "Success");
                } else {
                    $('#delete_file_modal').modal('hide');
                    toastr.error(response.message, "Error");
                }
            } catch (err) {
                $('#delete_file_modal').modal('hide');
                alert("An error occurred while deleting the file!");
                console.error(err);
            } finally {
                // Restore modal content
                $("#deleteModalContent").removeClass("d-none");
                $("#deleteModalSpinner").addClass("d-none");
            }
        });

</script>
