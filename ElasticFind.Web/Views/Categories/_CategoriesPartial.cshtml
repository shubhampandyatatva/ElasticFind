@model ElasticFind.Repository.ViewModels.DisplayCategoriesViewModel

<div class="table-responsive">
    <table class="table shadow">
        <thead>
            <tr>
                <th scope="col" style="width: 12%;">Sr. No</th>
                <th scope="col" style="width: 14%;">Name</th>
                <th scope="col">Description</th>
                <th scope="col" class="text-start" style="width: 12%;">Created By</th>
                <th scope="col" class="text-center" style="width: 12%;">Action</th>
            </tr>
        </thead>
        <tbody>
            @for (int i=0; i<Model.CategoryList.Count; i++)
            {
                <tr>
                    <td class="align-middle">@(Model.PaginationViewModel.TotalRecords == 0 ? 0 : ((Model.PaginationViewModel.Page - 1) * Model.PaginationViewModel.PageSize + i + 1))</td>
                    <td class="align-middle">@Model.CategoryList[i].Name</td>
                    <td class="align-middle"><span class="@(Model.CategoryList[i].Description == null ? "text-muted" : "")" style="@(Model.CategoryList[i].Description == null ? "font-size: 15px;" : "")">@(Model.CategoryList[i].Description ?? "No Description Available")</span></td>
                    <td class="align-middle">@Model.CategoryList[i].CreatedBy</td>

                    <td class="align-middle">
                        <span class="d-flex justify-content-center align-items-center">
                            <i class="fa fa-pencil me-4 edit-category-icon pointer" data-category-name="@Model.CategoryList[i].Name" style="color: rgb(22, 107, 235);" data-toggle="tooltip" data-placement="bottom" title="Edit Category"></i>
                            <i class="fa fa-trash text-danger pointer" data-bs-toggle="modal" data-bs-target="#deleteCategoryModal" data-toggle="tooltip" data-placement="bottom" title="Delete Category" data-category-name="@Model.CategoryList[i].Name" onclick="setCategoryName('@Model.CategoryList[i].Name')"></i>
                        </span> 
                    </td> 
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="6">
                    <div class="d-flex justify-content-end align-items-center">
                        <span class="me-2">Items per page:</span>
                        <select class="pointer" id="itemsPerPage" onchange="changePageSize()">
                            <option value="5" selected=@(Model.PaginationViewModel.PageSize == 5 ? "selected" : null)>5</option>
                            <option value="10" selected=@(Model.PaginationViewModel.PageSize == 10 ? "selected" : null)>10</option>
                            <option value="15" selected=@(Model.PaginationViewModel.PageSize == 15 ? "selected" : null)>15</option>
                        </select>
                        <span class="ms-2">Showing @(Model.PaginationViewModel.PageSize * (Model.PaginationViewModel.Page - 1) + 1) -
                            @((Model.PaginationViewModel.PageSize * Model.PaginationViewModel.Page) > Model.PaginationViewModel.TotalRecords ? Model.PaginationViewModel.TotalRecords :
                                                        (Model.PaginationViewModel.PageSize * Model.PaginationViewModel.Page)) of @Model.PaginationViewModel.TotalRecords</span>
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary ms-2 @(Model.PaginationViewModel.Page > 1 ? "" : "disabled")"
                                id="firstPageButton" title="First Page" onclick="loadFirstPage()"><i
                                    class="bi bi-chevron-double-left"></i></button>

                        <button class="btn btn-sm btn-outline-secondary ms-2 @(Model.PaginationViewModel.Page > 1 ? "" : "disabled")"
                            onclick="loadPrevPage()">
                            <i class="bi bi-chevron-left"></i>
                        </button>

                        <button
                            class="btn btn-sm btn-outline-secondary ms-2 @(Model.PaginationViewModel.Page* Model.PaginationViewModel.PageSize < Model.PaginationViewModel.TotalRecords ? "" : "disabled")"
                            onclick="loadNextPage()">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary ms-2 @((Model.PaginationViewModel.Page * Model.PaginationViewModel.PageSize < Model.PaginationViewModel.TotalRecords) ? "" : "disabled")"
                                id="lastPageButton" title="Last Page" onclick="loadLastPage()"><i
                                    class="bi bi-chevron-double-right"></i></button>
                    </div>
                </td>
            </tr>
        </tfoot>
    </table>
</div>

<script>
    function loadFirstPage() {
        const searchString = $("#searchInput").val();
        const currentPageSize = parseInt($("#itemsPerPage").val());
        loadCategories(1, currentPageSize, searchString, null);
    }

    function loadPrevPage() {
        var page = @Model.PaginationViewModel.Page - 1;
        var pageSize = @Model.PaginationViewModel.PageSize;
        var searchString = $("#searchInput").val();
        loadCategories(page, pageSize, searchString, null);
    }

    function loadNextPage() {
        var page = @Model.PaginationViewModel.Page + 1;
        var pageSize = @Model.PaginationViewModel.PageSize;
        var searchString = $("#searchInput").val();
        loadCategories(page, pageSize, searchString, null);
    }

    function loadLastPage() {
        const searchString = $("#searchInput").val();
        const totalRecords = @Model.PaginationViewModel.TotalRecords;
        const currentPageSize = parseInt($("#itemsPerPage").val());
        currentPage = Math.ceil(totalRecords / currentPageSize);
        loadCategories(currentPage, currentPageSize, searchString, null);
    }

    $(function () {
        $('[data-toggle="tooltip"]').tooltip()
    });
</script>